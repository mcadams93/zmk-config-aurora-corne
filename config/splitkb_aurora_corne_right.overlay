#include "splitkb_aurora_corne.dtsi"

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    cs-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;

    glidepoint: glidepoint@0 {
        compatible = "cirque,pinnacle2";
        reg = <0>;
        spi-max-frequency = <1000000>;
        status = "okay";

        data-ready-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
        sensitivity = "1x";
        data-mode = "absolute";
        absolute-relative-multiplier = <12>;
        absolute-relative-divisor = <40>;
        absolute-touch-min-z = <10>;

        primary-tap-enable;
        absolute-tap-drag-enable;
        absolute-tap-max-ms = <200>;
        absolute-tap-max-movement = <80>;
        absolute-tap-click-ms = <30>;
        absolute-tap-drag-timeout-ms = <300>;

        absolute-right-edge-scroll-enable;
        absolute-scroll-zone = <240>;
        absolute-scroll-divisor = <40>;

        sleep-mode-enable;
        invert-x;
        invert-y;
    };
};

&glidepoint_split {
    device = <&glidepoint>;
};
