#include "splitkb_aurora_corne.dtsi"

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;

    glidepoint: glidepoint@0 {
        compatible = "cirque,pinnacle2";
        reg = <0>;
        spi-max-frequency = <1000000>;
        status = "okay";

        data-ready-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;

        data-mode = "absolute";
        sensitivity = "1x";
        clipping-enable;
        active-range-x-min = <128>;
        active-range-x-max = <1920>;
        active-range-y-min = <64>;
        active-range-y-max = <1472>;

        absolute-relative-multiplier = <12>;
        absolute-relative-divisor = <40>;
        absolute-touch-min-z = <12>;

        primary-tap-enable;
        absolute-tap-max-ms = <200>;
        absolute-tap-max-movement = <80>;
        absolute-tap-click-ms = <10>;
        absolute-tap-drag-enable;
        absolute-tap-drag-timeout-ms = <300>;

        absolute-secondary-tap-area-width = <520>;
        absolute-secondary-tap-area-height = <420>;

        absolute-right-edge-scroll-enable;
        absolute-scroll-zone = <240>;
        absolute-scroll-divisor = <40>;

        invert-x;
        invert-y;
    };
};

&glidepoint_split {
    device = <&glidepoint>;
};

// OLED unused; its I2C pins (SDA=P0.17, SCL=P0.20) are reused by the trackpad SPI (MOSI/SCK).
&pro_micro_i2c { status = "disabled"; };

// The shield enables the right encoder on pro_micro 19/18 (P0.02/P1.15),
// which are the trackpad CS and MISO pins. No encoder is fitted.
&right_encoder { status = "disabled"; };
