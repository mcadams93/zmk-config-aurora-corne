#include <behaviors/input_processor_absolute_to_relative.dtsi>
#include <behaviors/input_processor_gestures.dtsi>

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 29)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    cs-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;

    glidepoint: glidepoint@0 {
        compatible = "cirque,pinnacle";
        reg = <0>;
        spi-max-frequency = <10000000>;
        status = "okay";

        dr-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
        absolute-mode;
        absolute-mode-scale-to-width = <1024>;
        absolute-mode-scale-to-height = <1024>;
        absolute-mode-clamp-min-x = <0>;
        absolute-mode-clamp-max-x = <2047>;
        absolute-mode-clamp-min-y = <0>;
        absolute-mode-clamp-max-y = <1535>;
    };
};

&zip_gestures {
    tap-detection;
    tap-timout-ms = <130>;
    prevent_movement_during_tap;
    circular-scroll;
    circular-scroll-rim-percent = <12>;
    circular-scroll-width = <1024>;
    circular-scroll-height = <1024>;
    inertial-cursor;
    inertial-cursor-decay-percent = <96>;
    wait-for-new-position-ms = <30>;
};

/ {
    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        device = <&glidepoint>;
        input-processors = <&zip_gestures &zip_absolute_to_relative>;
    };
};
